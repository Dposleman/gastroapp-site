---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<MainLayout
  title="Learn — GastroApp"
  description="Guides on restaurant inventory, food waste reduction, kitchen production planning and operational workflows."
  pathname="/learn"
>
  <PageHero
    eyebrow="Learn"
    title="Restaurant operations guides and insights"
    description="Practical resources on inventory control, food waste reduction, production planning and kitchen workflow structure."
  />

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="grid gap-6 md:grid-cols-2">
      <a href="/learn/reduce-food-waste-restaurant" class="premium-card p-6">
        <p class="text-xs uppercase tracking-[0.22em] text-cyan-300">Food waste</p>
        <h2 class="mt-3 text-2xl font-semibold">How to reduce food waste in restaurants</h2>
        <p class="mt-4 leading-7 text-white/70">
          A practical guide to making food waste visible and reducing avoidable loss.
        </p>
      </a>

      <a href="/learn/restaurant-inventory-best-practices" class="premium-card p-6">
        <p class="text-xs uppercase tracking-[0.22em] text-cyan-300">Inventory</p>
        <h2 class="mt-3 text-2xl font-semibold">Restaurant inventory best practices</h2>
        <p class="mt-4 leading-7 text-white/70">
          Improve stock visibility, reduce friction and build more reliable inventory workflows.
        </p>
      </a>

      <a href="/learn/how-to-run-kitchen-production" class="premium-card p-6">
        <p class="text-xs uppercase tracking-[0.22em] text-cyan-300">Production</p>
        <h2 class="mt-3 text-2xl font-semibold">How to run kitchen production more effectively</h2>
        <p class="mt-4 leading-7 text-white/70">
          A guide to prep planning, production visibility and operational consistency.
        </p>
      </a>

      <a href="/learn/restaurant-operational-workflows" class="premium-card p-6">
        <p class="text-xs uppercase tracking-[0.22em] text-cyan-300">Operations</p>
        <h2 class="mt-3 text-2xl font-semibold">Restaurant operational workflows explained</h2>
        <p class="mt-4 leading-7 text-white/70">
          Why fragmented workflows create friction and how to replace them with structure.
        </p>
      </a>

      <a href="/learn/restaurant-prep-list-system" class="premium-card p-6 md:col-span-2">
        <p class="text-xs uppercase tracking-[0.22em] text-cyan-300">Prep systems</p>
        <h2 class="mt-3 text-2xl font-semibold">How to build a better restaurant prep list system</h2>
        <p class="mt-4 leading-7 text-white/70">
          Create clearer prep coordination, better accountability and more reliable execution.
        </p>
      </a>
    </div>
  </section>
</MainLayout>