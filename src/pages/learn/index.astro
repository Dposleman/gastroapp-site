---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Restaurant Operations Guides",
  description:
    "Guides on inventory, food waste reduction, production planning and kitchen operations.",
  url: "https://gastroapp.dk/learn",
};
---

<MainLayout
  title="Restaurant Operations Guides — GastroApp"
  description="Guides on inventory, food waste reduction, production planning and kitchen operations."
  pathname="/learn"
  schema={schema}
>
  <PageHero
    eyebrow="Learn"
    title="Restaurant operations guides"
    description="Explore practical resources on kitchen workflows, inventory control, production planning and food waste reduction."
  />

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="grid gap-6 md:grid-cols-2">
      <a href="/learn/reduce-food-waste-restaurant" class="premium-card p-6">
        <h2 class="text-xl font-semibold">How to reduce food waste in restaurants</h2>
        <p class="mt-3 text-white/70">Make waste visible and reduce avoidable losses.</p>
      </a>

      <a href="/learn/restaurant-inventory-best-practices" class="premium-card p-6">
        <h2 class="text-xl font-semibold">Restaurant inventory best practices</h2>
        <p class="mt-3 text-white/70">Improve stock visibility and operational control.</p>
      </a>

      <a href="/learn/how-to-run-kitchen-production" class="premium-card p-6">
        <h2 class="text-xl font-semibold">How to run kitchen production effectively</h2>
        <p class="mt-3 text-white/70">Prep planning and kitchen production workflows.</p>
      </a>

      <a href="/learn/restaurant-operational-workflows" class="premium-card p-6">
        <h2 class="text-xl font-semibold">Restaurant operational workflows explained</h2>
        <p class="mt-3 text-white/70">How structured workflows improve execution.</p>
      </a>

      <a href="/learn/restaurant-prep-list-system" class="premium-card p-6 md:col-span-2">
        <h2 class="text-xl font-semibold">How to build a better restaurant prep list system</h2>
        <p class="mt-3 text-white/70">Create clearer prep coordination and stronger execution.</p>
      </a>
    </div>
  </section>
</MainLayout>