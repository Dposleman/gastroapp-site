---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContentSection from "../components/ContentSection.astro";
import FeatureBulletGrid from "../components/FeatureBulletGrid.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import SimpleCTA from "../components/SimpleCTA.astro";
---

<MainLayout
  title="Restaurant Software Platform — GastroApp"
  description="Modern restaurant software platform for kitchen operations, inventory control, food waste management, production planning and team coordination."
  pathname="/restaurant-software"
>

<PageHero
  eyebrow="Restaurant Software"
  title="Restaurant software built for modern kitchen operations"
  description="GastroApp helps restaurants manage recipes, inventory, production, events and team coordination in one structured operational platform."
/>

<ContentSection
  title="Restaurant operations are becoming more complex"
  paragraphs={[
    "Modern restaurant teams manage far more complexity than before. Inventory must be tracked more precisely, teams need clearer coordination and kitchens need better operational visibility.",
    "Many restaurants still rely on spreadsheets, fragmented tools or manual workflows. These systems break down as restaurants grow or when operations become more demanding.",
    "Restaurant software should simplify operations, not add more complexity."
  ]}
/>

<FeatureBulletGrid
  title="Core operational areas GastroApp helps manage"
  items={[
    "Recipe management and kitchen documentation.",
    "Inventory visibility and stock control.",
    "Production planning and prep coordination.",
    "Food waste monitoring and loss reduction.",
    "Restaurant event preparation and planning.",
    "Team communication across the kitchen."
  ]}
/>

<ContentSection
  title="A restaurant operations platform, not just another tool"
  paragraphs={[
    "Many restaurant tools solve isolated problems. GastroApp focuses on the full operational workflow of a kitchen.",
    "Recipes connect to inventory, production connects to prep and food waste visibility improves decision making across the team.",
    "This creates a stronger operational foundation for restaurants that want more structure and more control."
  ]}
/>

<RelatedLinks
  title="Explore GastroApp operational systems"
  links={[
    { href: "/restaurant-inventory-software", label: "Restaurant Inventory Software" },
    { href: "/kitchen-management-software", label: "Kitchen Management Software" },
    { href: "/restaurant-production-software", label: "Restaurant Production Software" },
    { href: "/restaurant-food-waste-software", label: "Restaurant Food Waste Software" },
    { href: "/restaurant-operations-platform", label: "Restaurant Operations Platform" }
  ]}
/>

<RelatedLinks
  title="Learn more about restaurant operations"
  links={[
    { href: "/learn/restaurant-inventory-best-practices", label: "Restaurant inventory best practices" },
    { href: "/learn/how-to-run-kitchen-production", label: "How to run kitchen production effectively" },
    { href: "/learn/reduce-food-waste-restaurant", label: "How to reduce food waste in restaurants" },
    { href: "/learn/restaurant-operational-workflows", label: "Restaurant operational workflows explained" }
  ]}
/>

<SimpleCTA
  title="Looking for modern restaurant software?"
  text="GastroApp helps restaurants move from fragmented workflows to a structured operations platform designed for modern kitchens."
/>

</MainLayout>