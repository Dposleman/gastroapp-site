---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";
import Pricing from "../components/Pricing.astro";
import SimpleCTA from "../components/SimpleCTA.astro";
import FeatureBulletGrid from "../components/FeatureBulletGrid.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "GastroApp",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://gastroapp.dk/pricing",
  offers: [
    {
      "@type": "Offer",
      name: "Starter",
      price: "1250",
      priceCurrency: "DKK",
      availability: "https://schema.org/InStock",
    },
    {
      "@type": "Offer",
      name: "Most Popular",
      price: "1500",
      priceCurrency: "DKK",
      availability: "https://schema.org/InStock",
    },
    {
      "@type": "Offer",
      name: "Premium",
      price: "1975",
      priceCurrency: "DKK",
      availability: "https://schema.org/InStock",
    },
  ],
};
---

<MainLayout
  title="GastroApp Pricing — Restaurant Operations Software"
  description="Simple monthly pricing for restaurants that want better operational control across recipes, inventory, production and team coordination."
  pathname="/pricing"
  schema={schema}
>
  <PageHero
    eyebrow="Pricing"
    title="Simple pricing for modern restaurant operations"
    description="GastroApp is designed to create operational value quickly through better visibility, stronger coordination and less friction across daily workflows."
  />

  <FeatureBulletGrid
    title="What GastroApp helps you improve"
    items={[
      "Create more structure around recipes, inventory and production planning.",
      "Reduce avoidable friction created by spreadsheets and disconnected tools.",
      "Improve visibility for managers and kitchen teams across daily operations.",
      "Coordinate events, prep and team communication in one workspace.",
      "Standardize execution so operations feel more reliable and scalable.",
      "Build a stronger operational foundation as your restaurant grows."
    ]}
  />

  <Pricing />

  <SimpleCTA
    title="Choose the plan that fits your operation"
    text="Whether you are organizing a smaller kitchen or building a more structured multi-team workflow, GastroApp helps restaurants operate with more clarity."
  />
</MainLayout>