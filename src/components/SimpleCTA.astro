---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 pb-24 pt-10">
  <div class="rounded-[2rem] border border-cyan-400/20 bg-[linear-gradient(180deg,rgba(34,211,238,0.10)_0%,rgba(6,9,20,0.96)_100%)] px-8 py-16 text-center shadow-[0_0_60px_rgba(34,211,238,0.08)]">
    <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">
      {title}
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/70">
      {text}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://app.gastroapp.dk/login"
        class="rounded-2xl bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-500 px-7 py-3.5 text-sm font-semibold text-black shadow-[0_12px_40px_rgba(34,211,238,0.28)] transition hover:-translate-y-0.5"
      >
        Start Free Trial
      </a>

      <a
        href="/pricing"
        class="rounded-2xl border border-white/10 bg-white/5 px-7 py-3.5 text-sm font-medium text-white transition hover:bg-white/8"
      >
        View Pricing
      </a>
    </div>
  </div>
</section>