---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="relative mx-auto max-w-6xl px-6 pb-16 pt-24 md:pt-28">
  <div class="soft-orb hero-float left-[12%] top-10 h-36 w-36 bg-cyan-400/20"></div>
  <div class="soft-orb hero-float-delayed right-[14%] top-16 h-40 w-40 bg-violet-500/16"></div>

  <div class="mx-auto max-w-4xl text-center">
    <div class="mb-6 inline-flex rounded-full border border-cyan-400/20 bg-cyan-400/10 px-4 py-2 text-xs font-medium uppercase tracking-[0.2em] text-cyan-200 shadow-[0_0_30px_rgba(34,211,238,0.10)]">
      {eyebrow}
    </div>

    <h1 class="text-4xl font-semibold leading-[1.04] tracking-tight md:text-6xl">
      {title}
    </h1>

    <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/70 md:text-xl">
      {description}
    </p>
  </div>
</section>