---
interface Props {
  category: string;
  title: string;
  description: string;
}

const { category, title, description } = Astro.props;
---

<section class="relative mx-auto max-w-5xl px-6 pb-12 pt-24 md:pt-28">
  <div class="mx-auto max-w-4xl text-center">
    <div class="mb-6 inline-flex rounded-full border border-cyan-400/20 bg-cyan-400/10 px-4 py-2 text-xs font-medium uppercase tracking-[0.2em] text-cyan-200 shadow-[0_0_30px_rgba(34,211,238,0.10)]">
      {category}
    </div>

    <h1 class="text-4xl font-semibold leading-[1.04] tracking-tight md:text-6xl">
      {title}
    </h1>

    <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/70 md:text-xl">
      {description}
    </p>
  </div>
</section>