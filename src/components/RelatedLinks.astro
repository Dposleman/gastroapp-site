---
interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  links: LinkItem[];
}

const { title, links } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-10">
  <div class="premium-card p-8">
    <h2 class="text-2xl font-semibold tracking-tight">{title}</h2>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {links.map((link) => (
        <a
          href={link.href}
          class="rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-white/80 transition hover:border-cyan-400/20 hover:bg-cyan-400/8 hover:text-white"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>