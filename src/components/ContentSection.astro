---
interface Props {
  title: string;
  paragraphs: string[];
}

const { title, paragraphs } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-12">
  <div class="premium-card p-8 md:p-10">
    <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{title}</h2>

    <div class="mt-6 space-y-5">
      {paragraphs.map((paragraph: string) => (
        <p class="text-base leading-8 text-white/72 md:text-lg">
          {paragraph}
        </p>
      ))}
    </div>
  </div>
</section>